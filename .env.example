# Bull Market Brokers — credenciales del homebroker
# El HB_BROKER_ID de Bull Market está en el README de pyhomebroker
HB_DNI=
HB_USER=
HB_PASSWORD=
HB_BROKER_ID=

# Telegram — para alertas (obtené el token del @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Parámetros opcionales (tienen defaults razonables)
MIN_TNA_SPREAD_PCT=5.0
RECORDER_INTERVAL_S=120

# Recomendador v2
DIRECTIONAL_ENABLED=false    # true para activar contexto de mercado experimental
DEFAULT_CAPITAL=              # capital en ARS para dimensionar las recomendaciones (ej: 500000)

# Hold-vs-swing optimizer (v2.1)
HORIZON_MONITOR_ENABLED=false # true para activar el monitor de posiciones abiertas
SWING_SPREAD_BUYBACK_PCT=0.10 # spread estimado al recomprar la opción (10%)
OPEN_POSITIONS_FILE=data/open_positions.jsonl

# Historial del subyacente — v2.2 (PyOBD, sin credenciales)
HISTORY_DIR=data/history         # directorio de cache parquet del subyacente
