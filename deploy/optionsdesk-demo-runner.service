[Unit]
Description=OptionsDesk - Demo runner LAB_INFINITE
After=network-online.target optionsdesk-recorder.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=optionsdesk
WorkingDirectory=/opt/optionsdesk
EnvironmentFile=/opt/optionsdesk/.env
ExecStart=/opt/optionsdesk/.venv/bin/python -m optionsdesk.backtest.demo_runner --interval 300 --lab-infinite
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
